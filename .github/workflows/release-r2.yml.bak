name: Release Prometheus

on:
  push:
    tags:
      - "v*.*.*"

permissions:
  contents: read

jobs:
  release:
    runs-on: windows-latest
    env:
      VERSION: ${{ github.ref_name }}
      UPDATE_API_BASE_URL: ${{ vars.UPDATE_API_BASE_URL }}
      UPDATE_SIGNING_PUBLIC_KEY_BASE64: ${{ vars.UPDATE_SIGNING_PUBLIC_KEY_BASE64 }}
      R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}
      R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
      R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
      R2_BUCKET: ${{ secrets.R2_BUCKET }}
      UPDATE_SIGNING_PRIVATE_KEY_PEM_BASE64: ${{ secrets.UPDATE_SIGNING_PRIVATE_KEY_PEM_BASE64 }}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "10.0.x"

      - name: Resolve version
        shell: pwsh
        run: |
          $releaseVersion = $env:VERSION.TrimStart('v')
          "RELEASE_VERSION=$releaseVersion" | Out-File -FilePath $env:GITHUB_ENV -Append

      - name: Restore and test
        run: |
          dotnet restore src/Prometheus.slnx
          dotnet test src/Prometheus.slnx -c Release --no-restore

      - name: Publish desktop
        shell: pwsh
        run: |
          dotnet publish src/Prometheus/Prometheus.csproj -c Release -r win-x64 --self-contained true `
            -p:PublishSingleFile=false -p:PublishReadyToRun=false -p:DebugType=None -p:DebugSymbols=false `
            -p:UpdateApiBaseUrl=$env:UPDATE_API_BASE_URL `
            -p:UpdateSigningPublicKeyBase64=$env:UPDATE_SIGNING_PUBLIC_KEY_BASE64 `
            -p:UsingDefaultUpdateSigningKey=false -o artifacts/desktop

      - name: Publish Native AOT bootstrapper
        shell: pwsh
        run: |
          dotnet publish src/Prometheus.Updater/Prometheus.Updater.csproj -c Release -r win-x64 `
            -p:UpdateSigningPublicKeyBase64=$env:UPDATE_SIGNING_PUBLIC_KEY_BASE64 `
            -p:UsingDefaultUpdateSigningKey=false -o artifacts/bootstrapper

      - name: Sign, package, and upload release
        shell: pwsh
        run: |
          $keyPath = Join-Path $env:RUNNER_TEMP 'prometheus-update-key.pem'
          [IO.File]::WriteAllBytes($keyPath, [Convert]::FromBase64String($env:UPDATE_SIGNING_PRIVATE_KEY_PEM_BASE64))
          dotnet run --project src/Prometheus.ReleaseTool/Prometheus.ReleaseTool.csproj -c Release -- `
            --version $env:RELEASE_VERSION `
            --git-tag $env:VERSION `
            --publish-dir artifacts/desktop `
            --bootstrapper artifacts/bootstrapper/Prometheus.exe `
            --output release-output `
            --private-key $keyPath `
            --repository-root . `
            --account-id $env:R2_ACCOUNT_ID `
            --access-key $env:R2_ACCESS_KEY_ID `
            --secret-key $env:R2_SECRET_ACCESS_KEY `
            --bucket $env:R2_BUCKET `
            --minimum-supported 0.0.0 `
            --minimum-bootstrapper 1.0.0 `
            --bootstrapper-version $env:RELEASE_VERSION `
            --notes-zh "Prometheus $env:RELEASE_VERSION" `
            --notes-en "Prometheus $env:RELEASE_VERSION"

      - uses: actions/upload-artifact@v4
        with:
          name: prometheus-${{ env.RELEASE_VERSION }}
          path: release-output/
