<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol">
    <Style x:Key="LiveCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="LiveCaption" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <SolidColorBrush x:Key="PostGamePieSliceBrush1" Color="#4C8DFF" />
    <SolidColorBrush x:Key="PostGamePieSliceBrush2" Color="#8B6CE4" />
    <SolidColorBrush x:Key="PostGamePieSliceBrush3" Color="#37AEB4" />
    <SolidColorBrush x:Key="PostGamePieSliceBrush4" Color="#D69A3A" />
    <SolidColorBrush x:Key="PostGamePieSliceBrush5" Color="#D8669A" />
    <Style x:Key="PostGameMetricToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="MetricBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MetricBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            <Setter TargetName="MetricBorder" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MetricBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LivePlayerButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border
                            x:Name="FocusBorder"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="10" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanOpenProfile}" Value="True">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTip" Value="{DynamicResource Match.Live.OpenProfile}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LivePlayerCard" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="92" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource MainContentForegroundDrawingBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter Property="Opacity" Value="0.78" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="BorderBrush" Value="#D85C5C" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LiveInlineButton" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LiveRecentDetailsButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="LivePlayerTemplate">
        <StackPanel>
            <Border AutomationProperties.Name="{Binding DisplayName}" Style="{StaticResource LivePlayerCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <!--  Fixed so loaded and not-yet-loaded cards keep identical geometry.  -->
                        <RowDefinition Height="31" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="36"
                        Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{Binding PositionText}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Border
                        Grid.Column="1"
                        Width="46"
                        Height="46"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8">
                        <Image Source="{Binding ChampionIcon}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center">
                        <Border
                            Width="18"
                            Height="18"
                            Margin="0,0,0,3"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4">
                            <Image Source="{Binding Spell1Icon}" Stretch="UniformToFill" />
                        </Border>
                        <Border
                            Width="18"
                            Height="18"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4">
                            <Image Source="{Binding Spell2Icon}" Stretch="UniformToFill" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="3" Margin="10,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                MaxWidth="164"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Margin="6,0,0,0"
                                Padding="6,2"
                                Background="{DynamicResource InfoBrush}"
                                CornerRadius="8"
                                Visibility="{Binding IsLocalPlayer, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="White"
                                    Text="{DynamicResource Match.Live.LocalTag}" />
                            </Border>
                            <Button
                                AutomationProperties.Name="{DynamicResource Match.Live.OpenProfile}"
                                Command="{Binding DataContext.OpenPlayerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource Match.Live.Profile.Short}"
                                Style="{StaticResource LiveInlineButton}"
                                ToolTip="{DynamicResource Match.Live.OpenProfile}"
                                Visibility="{Binding CanOpenProfile, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Style="{StaticResource LiveCaption}"
                                Text="{Binding RankText}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <hc:LoadingCircle
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,5,0"
                                    Style="{DynamicResource LoadingBaseStyle}" />
                                <TextBlock
                                    MaxWidth="110"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{Binding StatusText}"
                                    TextAlignment="Right"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                MaxWidth="110"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#D85C5C"
                                Style="{StaticResource LiveCaption}"
                                Text="{Binding StatusText}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasError, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            <TextBlock
                                Grid.Column="1"
                                MaxWidth="110"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding StatusText}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource LiveCaption}" TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                                    <Condition Binding="{Binding HasError}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Button
                        Grid.Column="4"
                        AutomationProperties.Name="{DynamicResource Match.Live.RecentDetails.Open}"
                        Command="{Binding DataContext.SelectPlayerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding HasRecentMatchDetails}"
                        Style="{StaticResource LiveRecentDetailsButton}"
                        ToolTip="{DynamicResource Match.Live.RecentDetails.Open}">
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{Binding RecentRecordText}" />
                                <Border
                                    Grid.Column="1"
                                    Margin="7,0,0,0"
                                    Padding="5,2"
                                    CornerRadius="8"
                                    Visibility="{Binding HasStreak, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="#D85C5C" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StreakIsWinning}" Value="True">
                                                    <Setter Property="Background" Value="#45B97C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding StreakText}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="7,0,0,0"
                                    Foreground="{DynamicResource InfoBrush}"
                                    Text="{DynamicResource Match.Live.RecentDetails.Open.Short}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource LiveCaption}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasStreak}" Value="False" />
                                                        <Condition Binding="{Binding IsSelected}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource InfoBrush}"
                                    Text="▼"
                                    ToolTip="{DynamicResource Match.Live.RecentDetails.DockedHint}"
                                    Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </Grid>
                            <TextBlock
                                Margin="0,3,0,0"
                                HorizontalAlignment="Right"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Style="{StaticResource LiveCaption}"
                                Text="{Binding KdaText}" />
                        </StackPanel>
                    </Button>

                    <!--
                        Full-width 20-slot result strip. The container is always present
                        (even without data) so every card keeps the same internal geometry
                        and the strips line up across the roster.
                    -->
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="5"
                        Margin="0,6,0,0"
                        VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Empty track: also renders the unfilled slots when fewer than 20 games exist.  -->
                        <Border
                            Height="9"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True" />
                        <ItemsControl
                            Height="9"
                            VerticalAlignment="Top"
                            ItemsSource="{Binding RecentResults}"
                            SnapsToDevicePixels="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="20" Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="{x:Type ContentPresenter}">
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Height="9"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Top"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True"
                                        ToolTip="{Binding ResultTooltip}">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#D85C5C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                        <Setter Property="Background" Value="#45B97C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid
                            Grid.Row="1"
                            Margin="0,3,0,0"
                            Visibility="{Binding HasPerformanceData, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{DynamicResource Match.Live.Strip.Newest}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="10"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{DynamicResource Match.Live.Strip.Oldest}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
