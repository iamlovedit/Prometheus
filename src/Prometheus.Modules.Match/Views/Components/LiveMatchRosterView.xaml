<UserControl
    x:Class="Prometheus.Modules.Match.Views.Components.LiveMatchRosterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Prometheus.Modules.Match.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MatchViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MatchViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasRoster, Converter={StaticResource Boolean2VisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="14,12,14,6"
                        Style="{StaticResource LiveCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border
                                Height="3"
                                VerticalAlignment="Top"
                                Background="#4C8DFF"
                                CornerRadius="2" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{DynamicResource Match.Live.MyTeam}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource LiveCaption}"
                                        Text="{DynamicResource Match.Live.Recent20}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource LiveCaption}"
                                        Text="{Binding MyTeamStatusText}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemTemplate="{StaticResource LivePlayerTemplate}"
                                ItemsSource="{Binding MyTeam}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="14,12,14,6"
                        Style="{StaticResource LiveCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border
                                Height="3"
                                VerticalAlignment="Top"
                                Background="#D96C75"
                                CornerRadius="2" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{DynamicResource Match.Live.EnemyTeam}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource LiveCaption}"
                                        Text="{DynamicResource Match.Live.Recent20}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Style="{StaticResource LiveCaption}"
                                        Text="{Binding TheirTeamStatusText}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl
                                Grid.Row="1"
                                ItemTemplate="{StaticResource LivePlayerTemplate}"
                                ItemsSource="{Binding TheirTeam}" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  Docked recent-match detail bar: full width, fixed at the bottom  -->
        <Border
            Grid.Row="3"
            Height="12"
            Visibility="{Binding HasSelectedPlayer, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <Border
            Grid.Row="4"
            Padding="14,12"
            Style="{StaticResource LiveCard}"
            Visibility="{Binding HasSelectedPlayer, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8">
                        <Image Source="{Binding SelectedPlayer.ChampionIcon}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding SelectedPlayer.DisplayName}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Style="{StaticResource LiveCaption}"
                                Text="{DynamicResource Match.Live.RecentDetails.Title}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LiveCaption}" Text="{Binding SelectedPlayer.RankText}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                Style="{StaticResource LiveCaption}"
                                Text="{Binding SelectedPlayer.RecentRecordText}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                Style="{StaticResource LiveCaption}"
                                Text="{Binding SelectedPlayer.KdaText}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Match.Live.RecentDetails.KdaLabel}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource LiveCaption}"
                            Text="{DynamicResource Match.Live.RecentDetails.Order}" />
                    </StackPanel>
                    <Button
                        Grid.Column="3"
                        Width="30"
                        Height="30"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Generic.Close}"
                        Command="{Binding CloseDetailsCommand}"
                        Content="×"
                        FontSize="17"
                        Style="{StaticResource LiveInlineButton}"
                        ToolTip="{DynamicResource Generic.Close}" />
                </Grid>

                <ItemsControl
                    Grid.Row="1"
                    Margin="-3,10,-3,-3"
                    ItemsSource="{Binding SelectedPlayer.RecentMatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="94"
                                Height="104"
                                Margin="3"
                                Padding="7"
                                AutomationProperties.Name="{Binding AutomationText}"
                                Background="{DynamicResource MainContentForegroundDrawingBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="BorderBrush" Value="#D85C5C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                <Setter Property="BorderBrush" Value="#45B97C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LiveCaption}" Text="{Binding IndexText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{Binding ResultText}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#D85C5C" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                            <Setter Property="Foreground" Value="#45B97C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Border
                                        Grid.Row="1"
                                        Width="30"
                                        Height="30"
                                        Margin="0,5,0,4"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource SecondaryRegionBrush}"
                                        CornerRadius="6">
                                        <Grid>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="{Binding ChampionFallbackText}" />
                                            <Image Source="{Binding ChampionIcon}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="2"
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold">
                                        <Run Text="{Binding Kills}" />
                                        <Run Text=" / " />
                                        <Run Foreground="#D85C5C" Text="{Binding Deaths}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Assists}" />
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource LiveCaption}"
                                        Text="{Binding GameModeText}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
