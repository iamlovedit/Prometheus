<UserControl
    x:Class="Prometheus.Modules.Match.Views.Components.PostGameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Prometheus.Modules.Match.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Prometheus.Modules.Match.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MatchViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MatchViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Grid.Row="2"
        Padding="36"
        Style="{StaticResource LiveCard}"
        Visibility="{Binding IsPostGameVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
        <Grid>
            <StackPanel
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsPostGameLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:LoadingCircle
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Style="{DynamicResource LoadingBaseStyle}" />
                <TextBlock
                    Margin="0,22,0,0"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="{Binding PostGameResultText}" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource LiveCaption}"
                    Text="{Binding PostGameDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsPostGameLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <StackPanel Margin="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="36"
                        FontWeight="Bold"
                        Text="{Binding PostGameResultText}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="#D85C5C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPostGameVictory}" Value="True">
                                        <Setter Property="Foreground" Value="#45B97C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LiveCaption}" Text="{Binding PostGameModeText}" />
                        <TextBlock
                            Margin="8,0"
                            Style="{StaticResource LiveCaption}"
                            Text="·" />
                        <TextBlock Style="{StaticResource LiveCaption}" Text="{Binding PostGameDurationText}" />
                        <TextBlock
                            Margin="8,0"
                            Style="{StaticResource LiveCaption}"
                            Text="·" />
                        <TextBlock Style="{StaticResource LiveCaption}" Text="{Binding PostGameGameIdText}" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border
                            Margin="0,0,6,0"
                            Padding="14"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="50"
                                    Height="50"
                                    Background="{DynamicResource RegionBrush}"
                                    CornerRadius="9">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{Binding PostGameLocalChampionFallbackText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Image Source="{Binding PostGameLocalChampionIcon}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource Match.Live.PostGame.YourPerformance}" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        Style="{StaticResource LiveCaption}"
                                        Text="{Binding PostGameLocalKdaText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Margin="6,0"
                            Padding="10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Width="54" Height="54">
                                    <controls:DoughnutChart
                                        ItemsSource="{Binding PostGameKillParticipationSlices}"
                                        Maximum="100"
                                        RingThickness="7"
                                        TrackBrush="{DynamicResource BorderBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{Binding PostGameKillParticipationText}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.KillParticipation}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Margin="6,0"
                            Padding="10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Width="54" Height="54">
                                    <controls:DoughnutChart
                                        ItemsSource="{Binding PostGameDamageShareSlices}"
                                        Maximum="100"
                                        RingThickness="7"
                                        TrackBrush="{DynamicResource BorderBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{Binding PostGameDamageShareText}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.DamageShare}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Padding="10"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Width="54" Height="54">
                                    <controls:DoughnutChart
                                        ItemsSource="{Binding PostGameGoldShareSlices}"
                                        Maximum="100"
                                        RingThickness="7"
                                        TrackBrush="{DynamicResource BorderBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{Binding PostGameGoldShareText}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.GoldShare}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border
                        Margin="0,14,0,0"
                        Padding="16"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="10"
                        Visibility="{Binding HasPostGameTeamDetails, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Match.Live.PostGame.TeamComposition}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton
                                        Command="{Binding SelectPostGameMetricCommand}"
                                        CommandParameter="ChampionDamage"
                                        Content="{DynamicResource Match.Live.PostGame.Metric.ChampionDamage}"
                                        IsChecked="{Binding IsPostGameDamageMetric, Mode=OneWay}"
                                        Style="{StaticResource PostGameMetricToggle}" />
                                    <ToggleButton
                                        Command="{Binding SelectPostGameMetricCommand}"
                                        CommandParameter="GoldEarned"
                                        Content="{DynamicResource Match.Live.PostGame.Metric.Gold}"
                                        IsChecked="{Binding IsPostGameGoldMetric, Mode=OneWay}"
                                        Style="{StaticResource PostGameMetricToggle}" />
                                    <ToggleButton
                                        Command="{Binding SelectPostGameMetricCommand}"
                                        CommandParameter="DamageTaken"
                                        Content="{DynamicResource Match.Live.PostGame.Metric.DamageTaken}"
                                        IsChecked="{Binding IsPostGameDamageTakenMetric, Mode=OneWay}"
                                        Style="{StaticResource PostGameMetricToggle}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="176" Height="176">
                                        <controls:DoughnutChart
                                            AutomationProperties.Name="{DynamicResource Match.Live.PostGame.MyTeamChart}"
                                            ItemsSource="{Binding PostGameMyTeamSlices}"
                                            RingThickness="27"
                                            TrackBrush="{DynamicResource BorderBrush}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Text="{Binding PostGameMyTeamTotalText}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource LiveCaption}"
                                                Text="{Binding PostGameMetricLabel}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Match.Live.PostGame.MyTeam}" />
                                        <ItemsControl ItemsSource="{Binding PostGameMyTeamSlices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="9"
                                                            Height="9"
                                                            CornerRadius="5">
                                                            <Border.Style>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush1}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="1">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush2}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="2">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush3}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="3">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush4}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="4">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush5}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource LiveCaption}"><Run Text="{Binding PercentageText}" /><Run Text=" · " /><Run Text="{Binding ValueText}" /></TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                                <Grid Grid.Column="2" Margin="18,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="176" Height="176">
                                        <controls:DoughnutChart
                                            AutomationProperties.Name="{DynamicResource Match.Live.PostGame.TheirTeamChart}"
                                            ItemsSource="{Binding PostGameTheirTeamSlices}"
                                            RingThickness="27"
                                            TrackBrush="{DynamicResource BorderBrush}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Text="{Binding PostGameTheirTeamTotalText}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource LiveCaption}"
                                                Text="{Binding PostGameMetricLabel}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Match.Live.PostGame.TheirTeam}" />
                                        <ItemsControl ItemsSource="{Binding PostGameTheirTeamSlices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="9"
                                                            Height="9"
                                                            CornerRadius="5">
                                                            <Border.Style>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush1}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="1">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush2}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="2">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush3}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="3">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush4}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PaletteIndex}" Value="4">
                                                                            <Setter Property="Background" Value="{StaticResource PostGamePieSliceBrush5}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding DisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource LiveCaption}"><Run Text="{Binding PercentageText}" /><Run Text=" · " /><Run Text="{Binding ValueText}" /></TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,14,0,0"
                        Padding="16"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="10"
                        Visibility="{Binding HasPostGameTeamDetails, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Match.Live.PostGame.PlayerDetails}" />
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="75" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.PlayerName}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="K / D / A" />
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.Gold}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.CreepScore}" />
                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.ChampionDamage}" />
                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.DamageTaken}" />
                                <TextBlock
                                    Grid.Column="7"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.Vision}" />
                                <TextBlock
                                    Grid.Column="8"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource LiveCaption}"
                                    Text="{DynamicResource Match.Live.PostGame.TeamShare}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PostGamePlayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="5"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MainContentForegroundDrawingBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="75" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="26"
                                                    Height="26"
                                                    Background="{DynamicResource RegionBrush}"
                                                    CornerRadius="5">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="8"
                                                            Text="{Binding ChampionFallbackText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Image Source="{Binding ChampionIcon}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <Setter Property="Fill" Value="#D85C5C" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMyTeam}" Value="True">
                                                                        <Setter Property="Fill" Value="#4C8DFF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding KdaText}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding GoldText}" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding CreepScoreText}" />
                                                <TextBlock
                                                    Grid.Column="5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding ChampionDamageText}" />
                                                <TextBlock
                                                    Grid.Column="6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DamageTakenText}" />
                                                <TextBlock
                                                    Grid.Column="7"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding VisionScoreText}" />
                                                <TextBlock
                                                    Grid.Column="8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource InfoBrush}"
                                                    Text="{Binding TeamShareText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,14,0,0"
                        Padding="16,12"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="10"
                        Visibility="{Binding HasPostGameTeamDetails, Converter={StaticResource Boolean2VisibilityReConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource LiveCaption}"
                            Text="{DynamicResource Match.Live.PostGame.DetailsUnavailable}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
