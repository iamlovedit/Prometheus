                                                                FontSize="8"
                                                                Text="{Binding ChampionFallbackText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <Image Source="{Binding ChampionIcon}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="{x:Type Ellipse}">
                                                                    <Setter Property="Fill" Value="#D85C5C" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMyTeam}" Value="True">
                                                                            <Setter Property="Fill" Value="#4C8DFF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding KdaText}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding GoldText}" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding CreepScoreText}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding ChampionDamageText}" />
                                                    <TextBlock
                                                        Grid.Column="6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding DamageTakenText}" />
                                                    <TextBlock
                                                        Grid.Column="7"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding VisionScoreText}" />
                                                    <TextBlock
                                                        Grid.Column="8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource InfoBrush}"
                                                        Text="{Binding TeamShareText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,14,0,0"
                            Padding="16,12"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="10"
                            Visibility="{Binding HasPostGameTeamDetails, Converter={StaticResource Boolean2VisibilityReConverter}}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource LiveCaption}"
                                Text="{DynamicResource Match.Live.PostGame.DetailsUnavailable}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="24"
            Style="{StaticResource LiveCard}"
            Visibility="{Binding ShowEmptyState, Converter={StaticResource Boolean2VisibilityConverter}}">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="{Binding EmptyTitle}" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource LiveCaption}"
                    Text="{Binding EmptyDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource InfoBrush}"
                    Text="{Binding PhaseText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
