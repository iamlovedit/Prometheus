                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="BorderBrush" Value="#D85C5C" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                <Setter Property="BorderBrush" Value="#45B97C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
