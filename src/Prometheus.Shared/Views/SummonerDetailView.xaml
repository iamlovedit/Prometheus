<UserControl
    x:Class="Prometheus.Shared.Views.SummonerDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.Shared.ViewModels"
    xmlns:views="clr-namespace:Prometheus.Shared.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:SummonerDetailViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="1080"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="CareerHeaderButton" BasedOn="{StaticResource ButtonIcon}" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="hc:IconElement.Width" Value="16" />
            <Setter Property="hc:IconElement.Height" Value="16" />
        </Style>
        <DataTemplate x:Key="RankCardTemplate">
            <Border Style="{DynamicResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock
                            Style="{DynamicResource PageSectionTitle}"
                            Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=Tag}" />
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Description}" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="100"
                            Height="100"
                            Source="{Binding RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}, Path=ToolTip}"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding DisplayTier, Mode=OneWay}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="{DynamicResource Career.Rank.Tier.LeaguePoints}" />
                                <Run Text=": " />
                                <Run Text="{Binding LeaguePoints}" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="{DynamicResource Career.Rank.Tier.Count}" />
                                <Run Text=": " />
                                <Run Text="{Binding Count, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="3">
                            <Border Margin="0,0,8,0" Style="{DynamicResource PageMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Tier.WinCount}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Wins}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,8,0" Style="{DynamicResource PageMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Tier.LossCount}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Losses}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource PageMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Tier.WinRate}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding WinRate, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Grid.Row="2" Columns="2">
                            <Border Margin="0,0,8,0" Style="{DynamicResource PageMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Tier.HighestTier}" />
                                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding DisplayHighestTier, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource PageMetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Tier.PreviousSeasonEndTier}" />
                                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding DisplayPreviosHighestTier, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="12" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Menu.Career}" />
                    <TextBlock Style="{DynamicResource PageDescription}" Text="{DynamicResource Career.Description}" />
                </StackPanel>
                <hc:UniformSpacingPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        hc:IconElement.Geometry="{StaticResource EditGeometry}"
                        Command="{Binding ModifyCommand}"
                        Style="{StaticResource CareerHeaderButton}"
                        ToolTip="{DynamicResource Career.Tips.SetSkin}"
                        Visibility="{Binding CanModify, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <Button
                        hc:IconElement.Geometry="{StaticResource BackGeometry}"
                        Command="{Binding BackMeCommand}"
                        Style="{StaticResource CareerHeaderButton}"
                        ToolTip="{DynamicResource Career.Tips.BackMe}"
                        Visibility="{Binding CanModify, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <Button
                        hc:IconElement.Geometry="{StaticResource RefreshGeometry}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource CareerHeaderButton}"
                        ToolTip="{DynamicResource Career.Tips.Refresh}" />
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="280" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BackgroundSkin}" Stretch="UniformToFill" />
                    </Border.Background>
                    <Grid>
                        <Border CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#22000000" />
                                    <GradientStop Offset="0.52" Color="#66000000" />
                                    <GradientStop Offset="1" Color="#E6000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,20">
                            <Border
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#99000000"
                                CornerRadius="14"
                                Visibility="{Binding IsPublic, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource LookGeometry}" Fill="White" Stretch="Uniform" />
                                    <TextBlock Margin="7,0,0,0" Foreground="White" FontWeight="SemiBold" Text="{DynamicResource Career.Private}" />
                                </StackPanel>
                            </Border>
                            <Grid VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="112" Height="112">
                                    <Grid.ToolTip>
                                        <StackPanel>
                                            <TextBlock><Run Text="{DynamicResource Career.Experience.Progress}" /><Run Text=": " /><Run Text="{Binding Summoner.PercentCompleteForNextLevel}" /><Run Text="%" /></TextBlock>
                                            <TextBlock><Run Text="{DynamicResource Career.Experience.Earned}" /><Run Text=": " /><Run Text="{Binding Summoner.XpSinceLastLevel}" /></TextBlock>
                                            <TextBlock><Run Text="{DynamicResource Career.Experience.Remaining}" /><Run Text=": " /><Run Text="{Binding Summoner.XpUntilNextLevel}" /></TextBlock>
                                        </StackPanel>
                                    </Grid.ToolTip>
                                    <hc:CircleProgressBar
                                        Width="112"
                                        Height="112"
                                        ArcThickness="4"
                                        Background="#40FFFFFF"
                                        Foreground="{DynamicResource InfoBrush}"
                                        IsHitTestVisible="False"
                                        Maximum="100"
                                        Minimum="0"
                                        RenderTransformOrigin="0.5,0.5"
                                        ShowText="False"
                                        Value="{Binding Summoner.PercentCompleteForNextLevel}">
                                        <hc:CircleProgressBar.RenderTransform><RotateTransform Angle="180" /></hc:CircleProgressBar.RenderTransform>
                                    </hc:CircleProgressBar>
                                    <hc:Gravatar Width="98" Height="98" Style="{StaticResource GravatarCircleImg}">
                                        <Image Source="{Binding ProfileIcon}" Stretch="UniformToFill" />
                                    </hc:Gravatar>
                                    <Border
                                        MinWidth="36"
                                        Height="22"
                                        Padding="7,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="#E61C1C1C"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="{Binding Summoner.SummonerLevel}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="18,0,0,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="White" Text="{Binding Summoner.GameName}" />
                                        <Button
                                            Width="32"
                                            Height="32"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            hc:IconElement.Width="18"
                                            hc:IconElement.Height="18"
                                            hc:IconElement.Geometry="{DynamicResource CopyGeometry}"
                                            Command="{Binding CopyCommand}"
                                            Foreground="White"
                                            Style="{DynamicResource ButtonIcon}"
                                            ToolTip="{DynamicResource Career.Copy}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0" FontSize="14" Foreground="White"><Run Text="#" /><Run Text="{Binding Summoner.TagLine}" /></TextBlock>
                                </StackPanel>
                                <Border Grid.Column="2"  VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" Text="{DynamicResource Career.Match.Last20}" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock FontSize="12" Foreground="#CCFFFFFF" Text="{DynamicResource Career.Match.Wins}" /><TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="Bold" Foreground="#FF77DD77" Text="{Binding Wins}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock FontSize="12" Foreground="#CCFFFFFF" Text="{DynamicResource Career.Match.Losses}" /><TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="Bold" Foreground="#FFFF7A6E" Text="{Binding Losses}" /></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock FontSize="12" Foreground="#CCFFFFFF" Text="{DynamicResource Career.Match.KDA}" /><TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="Bold" Foreground="White" Text="{Binding KDA}" /></StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding Solo}"
                        ContentTemplate="{StaticResource RankCardTemplate}"
                        Tag="{DynamicResource Career.Rank.Solo}"
                        ToolTip="{Binding SoloIcon}"
                        ToolTipService.IsEnabled="False" />
                    <ContentControl
                        Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding Flex}"
                        ContentTemplate="{StaticResource RankCardTemplate}"
                        Tag="{DynamicResource Career.Rank.Flex}"
                        ToolTip="{Binding FlexIcon}"
                        ToolTipService.IsEnabled="False" />
                </Grid>
                </Grid>
            </ScrollViewer>
            <Border
                Grid.Column="2"
                Padding="8"
                Style="{DynamicResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="8" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button
                            Height="34"
                            Command="{Binding MoreMatchCommand}"
                            Content="{DynamicResource Career.Match.History}"
                            Style="{DynamicResource ButtonPrimary}" />
                        <hc:ComboBox
                            Grid.Column="2"
                            Height="34"
                            SelectedIndex="{Binding SelectedMatchTypeIndex}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <prism:InvokeCommandAction Command="{Binding MatchTypeChangedCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ComboBoxItem Content="{DynamicResource Match.Rank.All}" />
                            <ComboBoxItem Content="{DynamicResource Match.Rank.ARAM}" />
                            <ComboBoxItem Content="{DynamicResource Match.Rank.Normal}" />
                            <ComboBoxItem Content="{DynamicResource Match.Rank.Solo}" />
                            <ComboBoxItem Content="{DynamicResource Match.Rank.Flex}" />
                        </hc:ComboBox>
                    </Grid>
                    <Grid Grid.Row="2">
                        <hc:LoadingCircle
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            Style="{DynamicResource LoadingBaseStyle}"
                            Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <views:MatchList
                            ItemsSource="{Binding RecentMatches}"
                            ItemCommand="{Binding MatchDetailCommand}"
                            Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
