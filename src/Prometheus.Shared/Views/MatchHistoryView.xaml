<UserControl
    x:Class="Prometheus.Shared.Views.MatchHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Prometheus.Shared.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.Shared.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MatchHistoryViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="1080"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border
            MinHeight="76"
            Style="{DynamicResource PageHeaderCard}"
            Visibility="{Binding ShowPageHeader, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                    Width="32"
                    Height="32"
                    Margin="0,0,12,0"
                    Padding="0"
                    hc:IconElement.Geometry="{StaticResource BackGeometry}"
                    hc:IconElement.Height="16"
                    hc:IconElement.Width="16"
                    Command="{Binding BackCommand}"
                    ToolTip="{DynamicResource Generic.Back}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Career.MatchHistory.Title}" />
                    <TextBlock Style="{DynamicResource PageDescription}" Text="{DynamicResource Career.MatchHistory.Description}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Grid.Row="1"
            Height="12"
            Visibility="{Binding ShowPageHeader, Converter={StaticResource Boolean2VisibilityConverter}}" />
        <Grid Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource PageCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.List}" />
                        <local:MatchList
                            Grid.Row="2"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource Boolean2BooleanReConverter}}"
                            ItemsSource="{Binding Matches}"
                            SelectedItem="{Binding SelectedMatch}"
                            SelectionChangedCommand="{Binding MatchChangedCommand}" />
                        <TextBlock
                            Grid.Row="4"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource PageCaption}"
                            Text="{DynamicResource Career.MatchHistory.LoadFailed}"
                            Visibility="{Binding ShowLoadError, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource PageCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.Detail}" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{DynamicResource PageMetricCard}">
                                <local:StatusBar Title="{DynamicResource Match.Date}" Value="{Binding MatchDetail.CreationDate}" />
                            </Border>
                            <Border Grid.Column="2" Style="{DynamicResource PageMetricCard}">
                                <local:StatusBar Title="{DynamicResource Match.GameMode}" Value="{Binding MatchDetail.DisplayGameMode}" />
                            </Border>
                            <Border Grid.Column="4" Style="{DynamicResource PageMetricCard}">
                                <local:StatusBar Title="{DynamicResource Match.GameDuration}" Value="{Binding MatchDetail.Duration}" />
                            </Border>
                            <Border Grid.Column="6" Style="{DynamicResource PageMetricCard}">
                                <local:StatusBar Title="{DynamicResource Match.Kill}" Value="{Binding MatchDetail.Kills}" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="4">
                            <ScrollViewer
                                HorizontalContentAlignment="Stretch"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                <StackPanel MinWidth="760">
                                    <Border Style="{DynamicResource PageMetricCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.BlueTeam}" />
                                            <local:DetailControl Grid.Row="2" Team="{Binding BlueTeam}" />
                                        </Grid>
                                    </Border>
                                    <Border Margin="0,12,0,0" Style="{DynamicResource PageMetricCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.PurpleTeam}" />
                                            <local:DetailControl Grid.Row="2" Team="{Binding PurPleTeam}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <HeaderedContentControl
                MinWidth="360"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="2"
                AutomationProperties.LiveSetting="Polite"
                Content="{DynamicResource Career.MatchHistory.Loading.Description}"
                Header="{DynamicResource Career.MatchHistory.Loading.Title}"
                Style="{DynamicResource QueryLoadingIndicator}"
                Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" />
        </Grid>

        <Grid
            Grid.RowSpan="3"
            Panel.ZIndex="10"
            Visibility="{Binding IsPreviewOpen, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Button
                Background="#66000000"
                BorderThickness="0"
                Command="{Binding ClosePreviewCommand}"
                Focusable="False" />
            <Border
                Width="390"
                Margin="0"
                HorizontalAlignment="Right"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                CornerRadius="12,0,0,12"
                Effect="{DynamicResource EffectShadow2}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{DynamicResource PageSectionTitle}"
                            Text="{DynamicResource Career.Preview.Title}" />
                        <Button
                            Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{Binding ClosePreviewCommand}"
                            Content="×"
                            FontSize="18"
                            ToolTip="{DynamicResource Generic.Close}" />
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <ScrollViewer
                                Padding="16"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding ShowPreviewError, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <hc:Gravatar
                                            Width="58"
                                            Height="58"
                                            Style="{StaticResource GravatarCircleImg}">
                                            <Image Source="{Binding Preview.ProfileIcon}" Stretch="UniformToFill" />
                                        </hc:Gravatar>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Text="{Binding Preview.Summoner.FullName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource PageCaption}">
                                                <Run Text="{DynamicResource Career.Preview.Level}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Preview.Summoner.SummonerLevel}" />
                                                <Run Text=" · " />
                                                <Run Text="{DynamicResource Career.Preview.SameRegion}" />
                                            </TextBlock>
                                        </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{DynamicResource PageMetricCard}">
                                            <StackPanel>
                                                <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Solo}" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Preview.Solo.DisplayTier}" />
                                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource PageCaption}">
                                                    <Run Text="{Binding Preview.Solo.LeaguePoints}" />
                                                    <Run Text=" LP · " />
                                                    <Run Text="{Binding Preview.Solo.WinRate}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{DynamicResource PageMetricCard}">
                                            <StackPanel>
                                                <TextBlock Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Rank.Flex}" />
                                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Preview.Flex.DisplayTier}" />
                                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource PageCaption}">
                                                    <Run Text="{Binding Preview.Flex.LeaguePoints}" />
                                                    <Run Text=" LP · " />
                                                    <Run Text="{Binding Preview.Flex.WinRate}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        </Grid>

                                        <UniformGrid Margin="0,12,0,0" Columns="3">
                                        <Border Margin="0,0,6,0" Style="{DynamicResource PageMetricCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.Record}" />
                                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontWeight="SemiBold">
                                                    <Run Text="{Binding Preview.Wins}" />
                                                    <Run Text="{DynamicResource Career.Preview.WinSuffix}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Preview.Losses}" />
                                                    <Run Text="{DynamicResource Career.Preview.LossSuffix}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,6,0" Style="{DynamicResource PageMetricCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.WinRate}" />
                                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Preview.WinRate}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{DynamicResource PageMetricCard}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.AverageKda}" />
                                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Preview.Kda}" />
                                            </StackPanel>
                                        </Border>
                                        </UniformGrid>

                                        <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource PageSectionTitle}">
                                            <Run Text="{DynamicResource Career.Preview.RecentPrefix}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Preview.MatchCount}" />
                                            <Run Text=" " />
                                            <Run Text="{DynamicResource Career.Preview.RecentSuffix}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource PageCaption}">
                                            <Run Text="{Binding Preview.Wins}" />
                                            <Run Text="{DynamicResource Career.Preview.WinSuffix}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Preview.Losses}" />
                                            <Run Text="{DynamicResource Career.Preview.LossSuffix}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Preview.WinRate}" />
                                        </TextBlock>
                                        </Grid>
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Preview.Results}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    x:Name="ResultBubble"
                                                    Width="26"
                                                    Height="26"
                                                    Margin="3"
                                                    Background="OrangeRed"
                                                    CornerRadius="13"
                                                    ToolTip="{DynamicResource Career.Preview.Loss}">
                                                    <TextBlock
                                                        x:Name="ResultText"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="×" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsWin}" Value="True">
                                                        <Setter TargetName="ResultBubble" Property="Background" Value="ForestGreen" />
                                                        <Setter TargetName="ResultBubble" Property="ToolTip" Value="{DynamicResource Career.Preview.Win}" />
                                                        <Setter TargetName="ResultText" Property="Text" Value="✓" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="3,5,3,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="ForestGreen" />
                                            <TextBlock Margin="5,0,12,0" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.Win}" />
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="OrangeRed" />
                                            <TextBlock Margin="5,0,0,0" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.Loss}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.Order}" />
                                        </Grid>
                                    </StackPanel>

                                    <Border
                                        Margin="0,18,0,0"
                                        Padding="14"
                                        Style="{DynamicResource PageMetricCard}"
                                        Visibility="{Binding ShowPreviewError, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Career.Preview.LoadFailed}" />
                                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{DynamicResource PageCaption}" Text="{DynamicResource Career.Preview.LoadFailed.Description}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <HeaderedContentControl
                                MinWidth="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{DynamicResource Career.Preview.Loading.Description}"
                                Header="{DynamicResource Career.Preview.Loading.Title}"
                                Style="{DynamicResource QueryLoadingIndicator}"
                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="16,12,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding ClosePreviewCommand}" Content="{DynamicResource Generic.Close}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding ViewFullRecordCommand}"
                            Content="{DynamicResource Career.Preview.ViewFull}"
                            Style="{DynamicResource ButtonPrimary}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
