<UserControl
    x:Class="Prometheus.Shared.Views.MatchHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Prometheus.Shared.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.Shared.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:MatchHistoryViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="1080"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Margin="4">
        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
        <Border Style="{DynamicResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button
                    Width="36"
                    Height="36"
                    Margin="0,0,14,0"
                    hc:IconElement.Width="16"
                    hc:IconElement.Height="16"
                    hc:IconElement.Geometry="{StaticResource BackGeometry}"
                    Command="{Binding BackCommand}"
                    Style="{DynamicResource ButtonPrimary}"
                    ToolTip="{DynamicResource Generic.Back}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Career.MatchHistory.Title}" />
                    <TextBlock Style="{DynamicResource PageDescription}" Text="{DynamicResource Career.MatchHistory.Description}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.List}" />
                    <local:MatchList
                        Grid.Row="2"
                        ItemsSource="{Binding Matches}"
                        SelectedItem="{Binding SelectedMatch}"
                        SelectionChangedCommand="{Binding MatchChangedCommand}" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                        <Button
                            Width="32"
                            Height="32"
                            hc:IconElement.Width="14"
                            hc:IconElement.Height="14"
                            hc:IconElement.Geometry="{DynamicResource PreviousGeometry}"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource Boolean2BooleanReConverter}}"
                            Style="{DynamicResource ButtonIcon}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CurrentPage}" />
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            hc:IconElement.Width="14"
                            hc:IconElement.Height="14"
                            hc:IconElement.Geometry="{DynamicResource NextGeometry}"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource Boolean2BooleanReConverter}}"
                            Style="{DynamicResource ButtonIcon}" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource PageCard}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.Detail}" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" />
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource PageMetricCard}"><local:StatusBar Title="{DynamicResource Match.Date}" Value="{Binding MatchDetail.CreationDate}" /></Border>
                        <Border Grid.Column="2" Style="{DynamicResource PageMetricCard}"><local:StatusBar Title="{DynamicResource Match.GameMode}" Value="{Binding MatchDetail.GameMode}" /></Border>
                        <Border Grid.Column="4" Style="{DynamicResource PageMetricCard}"><local:StatusBar Title="{DynamicResource Match.GameDuration}" Value="{Binding MatchDetail.Duration}" /></Border>
                        <Border Grid.Column="6" Style="{DynamicResource PageMetricCard}"><local:StatusBar Title="{DynamicResource Match.Kill}" Value="{Binding MatchDetail.Kills}" /></Border>
                    </Grid>
                    <Grid Grid.Row="4">
                        <hc:LoadingCircle Panel.ZIndex="2" Style="{DynamicResource LoadingCircleBaseStyle}" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <ScrollViewer
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
                            <StackPanel MinWidth="760">
                                <Border Style="{DynamicResource PageMetricCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.BlueTeam}" />
                                        <local:DetailControl Grid.Row="2" Team="{Binding BlueTeam}" />
                                    </Grid>
                                </Border>
                                <Border Margin="0,12,0,0" Style="{DynamicResource PageMetricCard}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Style="{DynamicResource PageSectionTitle}" Text="{DynamicResource Career.MatchHistory.PurpleTeam}" />
                                        <local:DetailControl Grid.Row="2" Team="{Binding PurPleTeam}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
