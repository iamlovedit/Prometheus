<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Prometheus</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <ApplicationIcon>..\Prometheus\Prometheus.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prometheus.Update\Prometheus.Update.csproj" />
  </ItemGroup>

  <Target Name="ValidateUpdateReleaseConfiguration" BeforeTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(UsingDefaultUpdateSigningKey)' == 'true'"
           Text="A production UpdateSigningPublicKeyBase64 is required for Release publishing." />
  </Target>

</Project>
