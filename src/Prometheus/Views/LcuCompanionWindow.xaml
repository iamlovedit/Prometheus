<Window
    x:Class="Prometheus.Views.LcuCompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:Prometheus.Desktop.Services"
    xmlns:viewmodels="clr-namespace:Prometheus.ViewModels"
    Title="Prometheus"
    Width="344"
    Height="680"
    d:DataContext="{d:DesignInstance Type=viewmodels:LcuCompanionViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CompanionCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="RuneChoiceButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CompanionQuickToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="AutomationTrack"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                            <Ellipse
                                x:Name="AutomationThumb"
                                Width="10"
                                Height="10"
                                Margin="3"
                                HorizontalAlignment="Left"
                                Fill="{DynamicResource SecondaryTextBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AutomationTrack" Property="Background" Value="{DynamicResource InfoBrush}" />
                                <Setter TargetName="AutomationTrack" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                <Setter TargetName="AutomationThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="AutomationThumb" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AutomationTrack" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="RunePerkTemplate">
            <Border
                Width="28"
                Height="28"
                Margin="0,0,5,0"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ToolTip="{Binding Name}">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="?" />
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Icon}"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecentResultTemplate">
            <Rectangle
                Width="5"
                Height="8"
                Margin="0,0,2,0"
                RadiusX="2"
                RadiusY="2">
                <Rectangle.Style>
                    <Style TargetType="{x:Type Rectangle}">
                        <Setter Property="Fill" Value="#D85C5C" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWin}" Value="True">
                                <Setter Property="Fill" Value="#45B97C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
        </DataTemplate>

        <DataTemplate x:Key="AutomationCardTemplate">
            <Border
                Height="66"
                Margin="3"
                Padding="9"
                Background="{DynamicResource MainContentForegroundDrawingBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.58" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="7">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="?" />
                            <Image Source="{Binding ChampionIcon}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{StaticResource CompanionCaption}"
                                Text="{Binding Label}"
                                TextTrimming="CharacterEllipsis" />
                            <ToggleButton
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                AutomationProperties.Name="{DynamicResource Companion.Automation.Toggle.ToolTip}"
                                Command="{Binding ToggleCommand}"
                                IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                Style="{StaticResource CompanionQuickToggle}"
                                ToolTip="{DynamicResource Companion.Automation.Toggle.ToolTip}"
                                Visibility="{Binding HasToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding ChampionName}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TeammateTemplate">
            <Border
                Height="76"
                Margin="0,0,0,6"
                Padding="8,0"
                Background="{DynamicResource MainContentForegroundDrawingBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Opacity" Value="0.76" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                <Setter Property="Opacity" Value="0.62" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="44"
                        Height="44"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="?" />
                            <Image Source="{Binding ChampionIcon}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>
                        <Grid VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CompanionCaption}"
                                Text="{Binding RankText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Style="{StaticResource CompanionCaption}"
                                Text="{Binding RecentRecordText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding KdaText}" />
                        </Grid>
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl
                                VerticalAlignment="Center"
                                ItemTemplate="{StaticResource RecentResultTemplate}"
                                ItemsSource="{Binding RecentResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border
            x:Name="CompanionChrome"
            Padding="14"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0,14,14,0">
            <Border.Effect>
                <DropShadowEffect
                    x:Name="CompanionShadow"
                    BlurRadius="18"
                    Opacity="0"
                    ShadowDepth="2" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                    <RowDefinition />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="11" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="9">
                        <Image
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            Source="{x:Static services:PrometheusIconSource.Large}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="{DynamicResource Companion.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CompanionCaption}" Text="{DynamicResource Match.Live.Phase.ChampionSelect}" />
                            <TextBlock
                                Margin="5,0"
                                Style="{StaticResource CompanionCaption}"
                                Text="·" />
                            <TextBlock
                                Style="{StaticResource CompanionCaption}"
                                Text="{Binding ModeText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Border
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="9">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding TeamStatusText}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{DynamicResource BorderBrush}"
                    Opacity="0.7" />

                <Border
                    Grid.Row="2"
                    Margin="0,10,0,6"
                    Padding="10"
                    Background="{DynamicResource MainContentForegroundDrawingBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="{Binding IsRuneRecommendationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{DynamicResource Companion.Runes.Title}" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CompanionCaption}"
                                    Text="{Binding RuneChampionText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CompanionCaption}"
                                Text="{Binding RuneSourceText}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding RuneStatusText}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource CompanionCaption}" TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRuneRecommendation}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRuneRecommendation}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding SelectPopularRuneCommand}" Content="{DynamicResource Companion.Runes.Popular}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RuneChoiceButton}" TargetType="{x:Type Button}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPopularRuneSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding SelectWinRateRuneCommand}"
                                        Content="{DynamicResource Companion.Runes.WinRate}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RuneChoiceButton}" TargetType="{x:Type Button}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWinRateRuneSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{Binding RuneStyleText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="7,0,0,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CompanionCaption}"
                                        Text="{Binding RuneStatsText}" />
                                </Grid>
                                <ItemsControl
                                    Grid.Row="2"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    ItemTemplate="{StaticResource RunePerkTemplate}"
                                    ItemsSource="{Binding RunePerks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button
                                    Grid.Row="3"
                                    Height="30"
                                    Margin="0,8,0,0"
                                    Command="{Binding ApplyRuneCommand}"
                                    Content="{Binding RuneApplyButtonText}"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Row="4"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding RuneStatusText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{DynamicResource Companion.Team.Title}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CompanionCaption}"
                        Text="{DynamicResource Companion.Team.RecentWindow}" />
                </Grid>

                <ScrollViewer
                    Grid.Row="4"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource TeammateTemplate}" ItemsSource="{Binding Teammates}" />
                </ScrollViewer>

                <Border
                    Grid.Row="5"
                    Margin="0,6,0,0"
                    Background="{DynamicResource BorderBrush}"
                    Opacity="0.7" />

                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="3,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{DynamicResource Companion.Automation.Title}" />
                    <ItemsControl
                        Grid.Row="1"
                        Margin="-3,0"
                        ItemTemplate="{StaticResource AutomationCardTemplate}"
                        ItemsSource="{Binding AutomationCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

            </Grid>
        </Border>
        <Rectangle
            x:Name="CompanionSeam"
            Width="3"
            HorizontalAlignment="Left"
            Panel.ZIndex="1"
            Fill="{DynamicResource InfoBrush}"
            IsHitTestVisible="False" />
    </Grid>
</Window>
