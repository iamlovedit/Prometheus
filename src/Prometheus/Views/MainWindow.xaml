<hc:Window
    x:Class="Prometheus.Views.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Prometheus.Core;assembly=Prometheus.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.ViewModels"
    Title="{Binding Title}"
    Width="1280"
    Height="820"
    MinWidth="1280"
    MinHeight="820"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Icon="../Resources/Prometheus_16.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Background="{DynamicResource MainContentForegroundDrawingBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="160"
                    MinWidth="160"
                    MaxWidth="160" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Margin="12" Background="{DynamicResource RegionBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <hc:SideMenu>
                    <hc:SideMenu.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource Iconfont}" />
                            <Setter Property="FontSize" Value="20" />
                        </Style>
                    </hc:SideMenu.Resources>

                    <hc:SideMenuItem Command="{Binding HomeCommand}" Header="{DynamicResource Menu.Home}" IsSelected="{Binding IsHomeSelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe609;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Command="{Binding CareerCommand}" Header="{DynamicResource Menu.Career}" IsSelected="{Binding IsCareerSelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe604;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>
                    <hc:SideMenuItem Command="{Binding InventoryCommand}" Header="{DynamicResource Menu.Inventory}" IsSelected="{Binding IsInventorySelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe607;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Command="{Binding SearchCommand}" Header="{DynamicResource Menu.Search}" IsSelected="{Binding IsSearchSelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe60c;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem
                        Command="{Binding MatchCommand}"
                        Header="{DynamicResource Menu.Match}"
                        IsEnabled="True"
                        IsSelected="{Binding IsMatchSelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe635;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Command="{Binding UtilityCommand}" Header="{DynamicResource Menu.Utility}" IsSelected="{Binding IsUtilitySelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe627;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem
                        VerticalAlignment="Bottom"
                        Command="{Binding SettingCommand}"
                        Header="{DynamicResource Menu.Setting}"
                        IsSelected="{Binding IsSettingSelected, Mode=OneWay}">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe60a;" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>
                </hc:SideMenu>

            </Grid>
            <Grid Grid.Column="1" Margin="12">
                <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />
                <Border
                    Panel.ZIndex="20"
                    Margin="24,8"
                    Padding="12,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource InfoBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasGlobalAlert, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="9"
                            Height="9"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource InfoBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding GlobalAlertText}" />
                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            Command="{Binding OpenAlertCommand}"
                            Content="{DynamicResource HomePage.Alert.Action}"
                            Style="{DynamicResource ButtonPrimary}" />
                        <Button
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Command="{Binding DismissAlertCommand}"
                            Content="×"
                            Style="{DynamicResource ButtonIcon}" />
                    </Grid>
                </Border>
            </Grid>
            <hc:NotifyIcon
                x:Name="TrayIcon"
                Icon="../Resources/Prometheus_16.ico"
                MouseDoubleClick="TrayIcon_MouseDoubleClick"
                Text="{Binding TrayToolTip}"
                Visibility="Visible">
                <hc:NotifyIcon.ContextContent>
                    <ContextMenu DataContext="{Binding DataContext, ElementName=RootWindow}">
                        <MenuItem
                            Header="{Binding TrayClientStatus}"
                            IsEnabled="False" />
                        <MenuItem
                            Header="{Binding TrayGameflowStatus}"
                            IsEnabled="False" />
                        <Separator />
                        <MenuItem
                            Command="{Binding ShowMainWindowCommand}"
                            Header="{DynamicResource Tray.ShowMainWindow}" />
                        <MenuItem
                            Command="{Binding OpenMatchFromTrayCommand}"
                            Header="{DynamicResource Tray.OpenMatch}"
                            IsEnabled="{Binding IsTrayMatchAvailable}" />
                        <MenuItem
                            Command="{Binding AcceptReadyCheckFromTrayCommand}"
                            Header="{DynamicResource HomePage.Action.Accept}"
                            Visibility="{Binding IsTrayReadyCheckAvailable, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource Tray.Automation}">
                            <MenuItem
                                Header="{DynamicResource Setting.Automation.AutoAccept}"
                                IsCheckable="True"
                                IsChecked="{Binding IsTrayAutoAcceptEnabled, Mode=TwoWay}" />
                            <MenuItem
                                Header="{DynamicResource Setting.Automation.AutoReconnect}"
                                IsCheckable="True"
                                IsChecked="{Binding IsTrayAutoReconnectEnabled, Mode=TwoWay}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{Binding OpenSettingsFromTrayCommand}"
                            Header="{DynamicResource Menu.Setting}" />
                        <Separator />
                        <MenuItem
                            Click="ExitApplication_Click"
                            Header="{DynamicResource Tray.Exit}" />
                    </ContextMenu>
                </hc:NotifyIcon.ContextContent>
            </hc:NotifyIcon>
        </Grid>
    </Border>
</hc:Window>
