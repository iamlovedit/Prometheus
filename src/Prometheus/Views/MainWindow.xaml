<hc:Window
    x:Class="Prometheus.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Prometheus.Core;assembly=Prometheus.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.ViewModels"
    Title="{Binding Title}"
    Width="1280"
    Height="820"
    MinWidth="1280"
    MinHeight="820"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Icon="../Resources/Prometheus_16.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <Style x:Key="SidebarNavigationItem" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid x:Name="ItemRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Border
                                x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" />
                            <Border
                                x:Name="SelectionIndicator"
                                Width="3"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="0,3,3,0"
                                Visibility="Collapsed" />
                            <Grid Margin="10,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="IconBackground"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    CornerRadius="8">
                                    <TextBlock
                                        x:Name="IconGlyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Iconfont}"
                                        FontSize="19"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Tag}" />
                                </Border>
                                <ContentPresenter
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    RecognizesAccessKey="False"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource MainContentForegroundDrawingBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="IconBackground" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="IconGlyph" Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemRoot" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Background="{DynamicResource MainContentForegroundDrawingBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="192"
                    MinWidth="192"
                    MaxWidth="192" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border
                Margin="12,12,0,12"
                Padding="10"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SecondaryRegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Image
                                Width="22"
                                Height="22"
                                Source="../Resources/Prometheus_16.ico"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="PROMETHEUS"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="8,0,8,8"
                        Background="{DynamicResource BorderBrush}" />

                    <StackPanel Grid.Row="2" VerticalAlignment="Top">
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Home}"
                            Command="{Binding HomeCommand}"
                            Content="{DynamicResource Menu.Home}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe609;" />
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Career}"
                            Command="{Binding CareerCommand}"
                            Content="{DynamicResource Menu.Career}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsCareerSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe604;" />
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Inventory}"
                            Command="{Binding InventoryCommand}"
                            Content="{DynamicResource Menu.Inventory}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsInventorySelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe607;" />
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Search}"
                            Command="{Binding SearchCommand}"
                            Content="{DynamicResource Menu.Search}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsSearchSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe60c;" />
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Match}"
                            Command="{Binding MatchCommand}"
                            Content="{DynamicResource Menu.Match}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsMatchSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe635;" />
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Utility}"
                            Command="{Binding UtilityCommand}"
                            Content="{DynamicResource Menu.Utility}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsUtilitySelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe627;" />
                    </StackPanel>

                    <Border
                        Grid.Row="3"
                        Height="1"
                        Margin="8,8"
                        Background="{DynamicResource BorderBrush}" />

                    <Grid Grid.Row="4">
                        <RadioButton
                            AutomationProperties.Name="{DynamicResource Menu.Setting}"
                            Command="{Binding SettingCommand}"
                            Content="{DynamicResource Menu.Setting}"
                            GroupName="MainNavigation"
                            IsChecked="{Binding IsSettingSelected, Mode=OneWay}"
                            Style="{StaticResource SidebarNavigationItem}"
                            Tag="&#xe60a;" />
                        <Border
                            Margin="0,0,10,0"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Panel.ZIndex="1"
                            Background="{DynamicResource DangerBrush}"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Visibility="{Binding HasAvailableUpdate, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{DynamicResource Update.Menu.Available}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="12">
                <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" />
                <Border
                    Margin="24,8"
                    Padding="12,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Panel.ZIndex="20"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource InfoBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasGlobalAlert, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="9"
                            Height="9"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource InfoBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding GlobalAlertText}" />
                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            Command="{Binding OpenAlertCommand}"
                            Content="{DynamicResource HomePage.Alert.Action}"
                            Style="{DynamicResource ButtonPrimary}" />
                        <Button
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Command="{Binding DismissAlertCommand}"
                            Content="×"
                            Style="{DynamicResource ButtonIcon}" />
                    </Grid>
                </Border>
            </Grid>
            <hc:NotifyIcon
                x:Name="TrayIcon"
                Icon="../Resources/Prometheus_16.ico"
                MouseDoubleClick="TrayIcon_MouseDoubleClick"
                Text="{Binding TrayToolTip}"
                Visibility="Visible">
                <hc:NotifyIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding TrayClientStatus}" IsEnabled="False" />
                        <MenuItem Header="{Binding TrayGameflowStatus}" IsEnabled="False" />
                        <Separator />
                        <MenuItem Command="{Binding ShowMainWindowCommand}" Header="{Binding TrayShowMainWindowText}" />
                        <MenuItem
                            Command="{Binding OpenMatchFromTrayCommand}"
                            Header="{Binding TrayOpenMatchText}"
                            IsEnabled="{Binding IsTrayMatchAvailable}" />
                        <MenuItem
                            Command="{Binding AcceptReadyCheckFromTrayCommand}"
                            Header="{Binding TrayAcceptText}"
                            Visibility="{Binding IsTrayReadyCheckAvailable, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <Separator />
                        <MenuItem Header="{Binding TrayAutomationText}">
                            <MenuItem
                                Header="{Binding TrayAutoAcceptText}"
                                IsCheckable="True"
                                IsChecked="{Binding IsTrayAutoAcceptEnabled, Mode=TwoWay}" />
                            <MenuItem
                                Header="{Binding TrayAutoReconnectText}"
                                IsCheckable="True"
                                IsChecked="{Binding IsTrayAutoReconnectEnabled, Mode=TwoWay}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding OpenSettingsFromTrayCommand}" Header="{Binding TraySettingsText}" />
                        <Separator />
                        <MenuItem Click="ExitApplication_Click" Header="{Binding TrayExitText}" />
                    </ContextMenu>
                </hc:NotifyIcon.ContextMenu>
            </hc:NotifyIcon>
        </Grid>
    </Border>
</hc:Window>
