<UserControl
    x:Class="Prometheus.Modules.Utility.Views.UtilityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Prometheus.Modules.Utility.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.Modules.Utility.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:UtilityViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="1080"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="UtilityCard" BasedOn="{StaticResource PageCard}" TargetType="{x:Type Border}" />
        <Style x:Key="SectionTitle" BasedOn="{StaticResource PageSectionTitle}" TargetType="{x:Type TextBlock}" />
        <Style x:Key="FieldName" BasedOn="{StaticResource PageFieldTitle}" TargetType="{x:Type TextBlock}" />
        <Style x:Key="CaptionText" BasedOn="{StaticResource PageCaption}" TargetType="{x:Type TextBlock}" />
        <local:DivisionConverter x:Key="DivisionConverter" />
        <local:ReDivisionConverter x:Key="ReDivisionConverter" />
        <local:TierShowConverter x:Key="TierShowConverter" />
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="12" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PageHeaderCard}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Menu.Utility}" />
                <TextBlock
                    Style="{DynamicResource PageDescription}"
                    Text="{DynamicResource Utility.Description}" />
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Margin="0,0,0,16"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource UtilityCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.CreateLobby}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{DynamicResource Utility.CreateLobby.Description}" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.CreateLobby.Name}" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="260"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.ShowClearButton="True"
                                    Style="{DynamicResource TextBoxExtend}"
                                    Text="{Binding LobbyName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.CreateLobby.Password}" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="260"
                                    hc:InfoElement.ShowClearButton="True"
                                    Style="{DynamicResource TextBoxExtend}"
                                    Text="{Binding LobbyPassword, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Button
                                Grid.Row="6"
                                MinWidth="100"
                                HorizontalAlignment="Right"
                                Command="{Binding CreateLobbyCommand}"
                                Content="{DynamicResource Utility.CreateLobby.Action}"
                                Style="{DynamicResource ButtonPrimary}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource UtilityCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.Profile}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{DynamicResource Utility.Profile.Description}" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Chat.Status.Tips}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Chat.Status.Description}" />
                                </StackPanel>
                                <hc:ComboBox
                                    Grid.Column="1"
                                    Width="220"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{Binding SelectedStatusIndex, Mode=TwoWay}"
                                    Style="{DynamicResource ComboBoxExtend}">
                                    <ComboBoxItem Content="{DynamicResource Chat.Status.Chat}" />
                                    <ComboBoxItem Content="{DynamicResource Chat.Status.Away}" />
                                    <ComboBoxItem Content="{DynamicResource Chat.Status.Offline}" />
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <prism:InvokeCommandAction Command="{Binding ChatStatusChangedCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </hc:ComboBox>
                            </Grid>

                            <Border
                                Grid.Row="4"
                                Background="{DynamicResource BorderBrush}" />

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.Profile.Status}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Profile.Status.Description}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox
                                        Width="220"
                                        Style="{DynamicResource TextBoxExtend}"
                                        Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Command="{Binding ConfirmStatusCommand}"
                                        Content="{DynamicResource Utility.Profile.Action}"
                                        Style="{DynamicResource ButtonPrimary}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource UtilityCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Chat.Tier.TierShow}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="{DynamicResource Utility.Tier.Description}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,7" Style="{StaticResource FieldName}" Text="{DynamicResource Match.Rank.Mode}" />
                                <ComboBox SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Match.Rank.TFT}" />
                                    <ComboBoxItem Content="{DynamicResource Match.Rank.Solo}" />
                                    <ComboBoxItem Content="{DynamicResource Match.Rank.Flex}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,7" Style="{StaticResource FieldName}" Text="{DynamicResource Match.Rank.Tier}" />
                                <ComboBox SelectedIndex="{Binding SelectedTierIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Unranked}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Iron}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Bronze}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Silver}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Gold}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Platinum}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Emerald}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Diamond}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Master}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Grandmaster}" />
                                    <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Challenger}" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="4"
                                Visibility="{Binding SelectedTierIndex, Converter={StaticResource TierShowConverter}}">
                                <TextBlock Margin="0,0,0,7" Style="{StaticResource FieldName}" Text="{DynamicResource Match.Rank.Division}" />
                                <Grid>
                                    <ComboBox
                                        IsEnabled="False"
                                        SelectedIndex="0"
                                        Visibility="{Binding SelectedTierIndex, Converter={StaticResource ReDivisionConverter}}">
                                        <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.NA}" />
                                    </ComboBox>
                                    <ComboBox
                                        SelectedIndex="{Binding SelectedDivisionIndex, Mode=TwoWay}"
                                        Visibility="{Binding SelectedTierIndex, Converter={StaticResource DivisionConverter}}">
                                        <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.I}" />
                                        <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.II}" />
                                        <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.III}" />
                                        <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.IV}" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <Button
                                Grid.Column="6"
                                MinWidth="100"
                                VerticalAlignment="Bottom"
                                Command="{Binding ApplyTierCommand}"
                                Content="{DynamicResource Utility.Tier.Action}"
                                Style="{DynamicResource ButtonPrimary}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
