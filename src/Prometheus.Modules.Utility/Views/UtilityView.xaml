<UserControl
    x:Class="Prometheus.Modules.Utility.Views.UtilityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Prometheus.Modules.Utility.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:Prometheus.Modules.Utility.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:UtilityViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="1080"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="UtilityCard"
            BasedOn="{StaticResource PageCard}"
            TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="SectionTitle"
            BasedOn="{StaticResource PageSectionTitle}"
            TargetType="{x:Type TextBlock}" />
        <Style
            x:Key="FieldName"
            BasedOn="{StaticResource PageFieldTitle}"
            TargetType="{x:Type TextBlock}" />
        <Style
            x:Key="CaptionText"
            BasedOn="{StaticResource PageCaption}"
            TargetType="{x:Type TextBlock}" />
        <Style x:Key="UtilityExpanderHeaderToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border
                            x:Name="HeaderBackground"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UtilityChevron" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Data" Value="M 1,1 L 5,5 L 9,1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UtilityExpander" TargetType="{x:Type Expander}">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource UtilityExpanderHeaderToggle}" />
                                <Border Grid.Row="1" Padding="18,0,18,18">
                                    <ContentPresenter
                                        x:Name="ExpandSite"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ChampionPriorityEditorTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.ChampionAutomation.AddChampion}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        IsDropDownOpen="{Binding IsDropDownOpen, Mode=TwoWay}"
                        IsEditable="True"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding ChampionOptions}"
                        MaxDropDownHeight="360"
                        ScrollViewer.CanContentScroll="True"
                        SelectedItem="{Binding SelectedChampion, Mode=TwoWay}"
                        StaysOpenOnEdit="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        TextSearch.TextPath="Name"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="DropDownOpened">
                                <prism:InvokeCommandAction Command="{Binding OpenSelectorCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="9" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <hc:Gravatar
                                        Width="34"
                                        Height="34"
                                        Style="{DynamicResource GravatarCircleImg}">
                                        <Image Source="{Binding IconUri}" Stretch="UniformToFill" />
                                    </hc:Gravatar>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding Alias}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="2"
                        MinWidth="76"
                        Command="{Binding AddChampionCommand}"
                        Content="{DynamicResource Utility.ChampionAutomation.Add}"
                        Style="{DynamicResource ButtonPrimary}" />
                </Grid>

                <TextBlock
                    Grid.Row="4"
                    Style="{StaticResource FieldName}"
                    Text="{DynamicResource Utility.ChampionAutomation.PriorityList}" />
                <ListBox
                    Grid.Row="6"
                    MinHeight="142"
                    MaxHeight="210"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding PreferredChampions}"
                    SelectedItem="{Binding SelectedPreferredChampion, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="42" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="9" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <hc:Gravatar
                                    Width="34"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource GravatarCircleImg}">
                                    <Image Source="{Binding IconUri}" Stretch="UniformToFill" />
                                </hc:Gravatar>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding Alias}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel
                    Grid.Row="8"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="68"
                        Command="{Binding MoveChampionUpCommand}"
                        Content="{DynamicResource Utility.ChampionAutomation.MoveUp}" />
                    <Button
                        MinWidth="68"
                        Margin="8,0,0,0"
                        Command="{Binding MoveChampionDownCommand}"
                        Content="{DynamicResource Utility.ChampionAutomation.MoveDown}" />
                    <Button
                        MinWidth="68"
                        Margin="8,0,0,0"
                        Command="{Binding RemoveChampionCommand}"
                        Content="{DynamicResource Utility.ChampionAutomation.Remove}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <local:DivisionConverter x:Key="DivisionConverter" />
        <local:ReDivisionConverter x:Key="ReDivisionConverter" />
        <local:TierShowConverter x:Key="TierShowConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="12" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PageHeaderCard}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Menu.Utility}" />
                <TextBlock Style="{DynamicResource PageDescription}" Text="{DynamicResource Utility.Description}" />
            </StackPanel>
        </Border>
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Expander IsExpanded="False" Style="{StaticResource UtilityExpander}">
                    <Expander.Header>
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.Panel.Room.Title}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{DynamicResource Utility.Panel.Room.Summary}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="14">
                                <Path Style="{StaticResource UtilityChevron}" />
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <Border Style="{StaticResource UtilityCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.CreateLobby}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{DynamicResource Utility.CreateLobby.Description}" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.CreateLobby.Name}" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="260"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.ShowClearButton="True"
                                    Style="{DynamicResource TextBoxExtend}"
                                    Text="{Binding LobbyName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.CreateLobby.Password}" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="260"
                                    hc:InfoElement.ShowClearButton="True"
                                    Style="{DynamicResource TextBoxExtend}"
                                    Text="{Binding LobbyPassword, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Button
                                Grid.Row="6"
                                MinWidth="100"
                                HorizontalAlignment="Right"
                                Command="{Binding CreateLobbyCommand}"
                                Content="{DynamicResource Utility.CreateLobby.Action}"
                                Style="{DynamicResource ButtonPrimary}" />
                        </Grid>
                    </Border>
                </Expander>

                <Expander
                    Margin="0,8,0,0"
                    IsExpanded="False"
                    Style="{StaticResource UtilityExpander}">
                    <Expander.Header>
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.Panel.Profile.Title}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{DynamicResource Utility.Panel.Profile.Summary}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="14">
                                <Path Style="{StaticResource UtilityChevron}" />
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <Border Style="{StaticResource UtilityCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.Profile}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Profile.Description}" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Chat.Status.Tips}" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{DynamicResource Chat.Status.Description}" />
                                    </StackPanel>
                                    <hc:ComboBox
                                        Grid.Column="1"
                                        Width="220"
                                        VerticalAlignment="Center"
                                        SelectedIndex="{Binding SelectedStatusIndex, Mode=TwoWay}"
                                        Style="{DynamicResource ComboBoxExtend}">
                                        <ComboBoxItem Content="{DynamicResource Chat.Status.Chat}" />
                                        <ComboBoxItem Content="{DynamicResource Chat.Status.Away}" />
                                        <ComboBoxItem Content="{DynamicResource Chat.Status.Offline}" />
                                    </hc:ComboBox>
                                </Grid>

                                <Border Grid.Row="4" Background="{DynamicResource BorderBrush}" />

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.Profile.Status}" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{DynamicResource Utility.Profile.Status.Description}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox
                                            Width="220"
                                            Height="32"
                                            Style="{DynamicResource TextBoxExtend}"
                                            Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            MinWidth="80"
                                            Margin="8,0,0,0"
                                            Command="{Binding ConfirmStatusCommand}"
                                            Content="{DynamicResource Utility.Profile.Action}"
                                            Style="{DynamicResource ButtonPrimary}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Margin="0,8,0,0" Style="{StaticResource UtilityCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Chat.Tier.TierShow}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Tier.Description}" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Style="{StaticResource FieldName}"
                                            Text="{DynamicResource Match.Rank.Mode}" />
                                        <ComboBox SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource Match.Rank.TFT}" />
                                            <ComboBoxItem Content="{DynamicResource Match.Rank.Solo}" />
                                            <ComboBoxItem Content="{DynamicResource Match.Rank.Flex}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Style="{StaticResource FieldName}"
                                            Text="{DynamicResource Match.Rank.Tier}" />
                                        <ComboBox SelectedIndex="{Binding SelectedTierIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Unranked}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Iron}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Bronze}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Silver}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Gold}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Platinum}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Emerald}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Diamond}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Master}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Grandmaster}" />
                                            <ComboBoxItem Content="{DynamicResource Career.Rank.Tier.Challenger}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Visibility="{Binding SelectedTierIndex, Converter={StaticResource TierShowConverter}}">
                                        <TextBlock
                                            Margin="0,0,0,7"
                                            Style="{StaticResource FieldName}"
                                            Text="{DynamicResource Match.Rank.Division}" />
                                        <Grid>
                                            <ComboBox
                                                IsEnabled="False"
                                                SelectedIndex="0"
                                                Visibility="{Binding SelectedTierIndex, Converter={StaticResource ReDivisionConverter}}">
                                                <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.NA}" />
                                            </ComboBox>
                                            <ComboBox SelectedIndex="{Binding SelectedDivisionIndex, Mode=TwoWay}" Visibility="{Binding SelectedTierIndex, Converter={StaticResource DivisionConverter}}">
                                                <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.I}" />
                                                <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.II}" />
                                                <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.III}" />
                                                <ComboBoxItem Content="{DynamicResource Match.Rank.Divisions.IV}" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>

                                    <Button
                                        Grid.Column="6"
                                        MinWidth="100"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ApplyTierCommand}"
                                        Content="{DynamicResource Utility.Tier.Action}"
                                        Style="{DynamicResource ButtonPrimary}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander
                    Margin="0,8,0,0"
                    IsExpanded="True"
                    Style="{StaticResource UtilityExpander}">
                    <Expander.Header>
                        <Grid MinHeight="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.Panel.Automation.Title}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Panel.Automation.PickOn}"
                                        Visibility="{Binding AutoPickChampion, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Panel.Automation.PickOff}"
                                        Visibility="{Binding AutoPickChampion, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text=" · " />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Panel.Automation.BanOn}"
                                        Visibility="{Binding AutoBanChampion, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Panel.Automation.BanOff}"
                                        Visibility="{Binding AutoBanChampion, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text=" · " />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Panel.Automation.AramOn}"
                                        Visibility="{Binding AutoSwapAramBench, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.Panel.Automation.AramOff}"
                                        Visibility="{Binding AutoSwapAramBench, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                </WrapPanel>
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="14">
                                <Path Style="{StaticResource UtilityChevron}" />
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <Border Style="{StaticResource UtilityCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.ChampionAutomation}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="{DynamicResource Utility.ChampionAutomation.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Padding="16"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.ChampionAutomation.Pick}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Style="{StaticResource CaptionText}"
                                                        Text="{DynamicResource Utility.ChampionAutomation.Pick.Description}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox
                                                    Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Content="{DynamicResource Utility.ChampionAutomation.Enable}"
                                                    IsChecked="{Binding AutoPickChampion, Mode=TwoWay}" />
                                            </Grid>
                                            <ContentControl
                                                Grid.Row="2"
                                                Content="{Binding PickChampionEditor}"
                                                ContentTemplate="{StaticResource ChampionPriorityEditorTemplate}" />
                                        </Grid>
                                    </Border>

                                    <Border
                                        Grid.Column="2"
                                        Padding="16"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.ChampionAutomation.Ban}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Style="{StaticResource CaptionText}"
                                                        Text="{DynamicResource Utility.ChampionAutomation.Ban.Description}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox
                                                    Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Content="{DynamicResource Utility.ChampionAutomation.Enable}"
                                                    IsChecked="{Binding AutoBanChampion, Mode=TwoWay}" />
                                            </Grid>
                                            <ContentControl
                                                Grid.Row="2"
                                                Content="{Binding BanChampionEditor}"
                                                ContentTemplate="{StaticResource ChampionPriorityEditorTemplate}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource CaptionText}"
                                    Text="{DynamicResource Utility.ChampionAutomation.Note}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Margin="0,8,0,0" Style="{StaticResource UtilityCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Utility.AramSwap}" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{DynamicResource Utility.AramSwap.Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{DynamicResource Utility.AramSwap.Enable}"
                                        IsChecked="{Binding AutoSwapAramBench, Mode=TwoWay}" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            Style="{StaticResource FieldName}"
                                            Text="{DynamicResource Utility.AramSwap.AddChampion}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                IsDropDownOpen="{Binding IsAramChampionDropDownOpen, Mode=TwoWay}"
                                                IsEditable="True"
                                                IsTextSearchEnabled="False"
                                                ItemsSource="{Binding AramChampionOptions}"
                                                MaxDropDownHeight="360"
                                                ScrollViewer.CanContentScroll="True"
                                                SelectedItem="{Binding SelectedAramChampion, Mode=TwoWay}"
                                                StaysOpenOnEdit="True"
                                                Text="{Binding AramChampionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                TextSearch.TextPath="Name"
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.VirtualizationMode="Recycling">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="DropDownOpened">
                                                        <prism:InvokeCommandAction Command="{Binding OpenAramChampionSelectorCommand}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                                <ComboBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ComboBox.ItemsPanel>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="42" Margin="2,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="9" />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <hc:Gravatar
                                                                Width="34"
                                                                Height="34"
                                                                Style="{DynamicResource GravatarCircleImg}">
                                                                <Image Source="{Binding IconUri}" Stretch="UniformToFill" />
                                                            </hc:Gravatar>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,2,0,0"
                                                                    Style="{StaticResource CaptionText}"
                                                                    Text="{Binding Alias}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button
                                                Grid.Column="2"
                                                MinWidth="88"
                                                Command="{Binding AddAramChampionCommand}"
                                                Content="{DynamicResource Utility.AramSwap.Add}"
                                                Style="{DynamicResource ButtonPrimary}" />
                                        </Grid>
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{DynamicResource Utility.AramSwap.AddChampion.Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldName}" Text="{DynamicResource Utility.AramSwap.PriorityList}" />
                                        <ListBox
                                            Grid.Row="2"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{Binding PreferredAramChampions}"
                                            SelectedItem="{Binding SelectedPreferredAramChampion, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="42" Margin="4,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="9" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <hc:Gravatar
                                                            Width="34"
                                                            Height="34"
                                                            VerticalAlignment="Center"
                                                            Style="{DynamicResource GravatarCircleImg}">
                                                            <Image Source="{Binding IconUri}" Stretch="UniformToFill" />
                                                        </hc:Gravatar>
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CaptionText}"
                                                            Text="{Binding Alias}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel
                                            Grid.Row="4"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                            <Button
                                                MinWidth="72"
                                                Command="{Binding MoveAramChampionUpCommand}"
                                                Content="{DynamicResource Utility.AramSwap.MoveUp}" />
                                            <Button
                                                MinWidth="72"
                                                Margin="8,0,0,0"
                                                Command="{Binding MoveAramChampionDownCommand}"
                                                Content="{DynamicResource Utility.AramSwap.MoveDown}" />
                                            <Button
                                                MinWidth="72"
                                                Margin="8,0,0,0"
                                                Command="{Binding RemoveAramChampionCommand}"
                                                Content="{DynamicResource Utility.AramSwap.Remove}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
