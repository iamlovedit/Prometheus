        </Geometry>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="12" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PageHeaderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Visibility="{Binding IsDiagnosticsOpen, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Setting.Title}" />
                        <TextBlock Style="{DynamicResource PageDescription}" Text="{DynamicResource Setting.Description}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{Binding OpenDiagnosticsCommand}"
                        Content="{DynamicResource Setting.Diagnostics.Open}"
                        Style="{DynamicResource ButtonIcon}" />
                </Grid>

                <Grid Grid.Column="0" Visibility="{Binding IsDiagnosticsOpen, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="36"
                        Height="36"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource BackGeometry}"
                        hc:IconElement.Height="16"
                        hc:IconElement.Width="16"
                        Command="{Binding OpenOverviewCommand}"
                        Style="{DynamicResource ButtonPrimary}"
                        ToolTip="{DynamicResource Setting.Diagnostics.Back}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource PageTitle}" Text="{DynamicResource Setting.Diagnostics}" />
                        <TextBlock Style="{DynamicResource PageDescription}" Text="{DynamicResource Setting.Diagnostics.Description}" />
                    </StackPanel>
                </Grid>

                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Margin="8,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource GitHubGeometry}"
                    hc:IconElement.Height="20"
                    hc:IconElement.Width="20"
                    AutomationProperties.Name="{DynamicResource Setting.GitHub.Open}"
                    Command="{Binding OpenGitHubCommand}"
                    Style="{DynamicResource ButtonIcon}"
                    ToolTip="{DynamicResource Setting.GitHub.ToolTip}" />
            </Grid>
        </Border>

        <ContentControl
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            prism:RegionManager.RegionName="{x:Static core:RegionNames.SettingContentRegion}" />
    </Grid>
</UserControl>
