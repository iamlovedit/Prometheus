<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Local builds use the fallback version. Release workflows inject
         RELEASE_VERSION from the validated v<major>.<minor>.<patch> Git tag. -->
    <EffectiveVersion Condition="'$(RELEASE_VERSION)' == ''">1.0.0</EffectiveVersion>
    <EffectiveVersion Condition="'$(RELEASE_VERSION)' != ''">$(RELEASE_VERSION)</EffectiveVersion>
    <Version>$(EffectiveVersion)</Version>
    <AssemblyVersion>$(EffectiveVersion).0</AssemblyVersion>
    <FileVersion>$(EffectiveVersion).0</FileVersion>
    <InformationalVersion>$(EffectiveVersion)</InformationalVersion>

    <!-- Release automation overrides these values. The default public key is
         intentionally unusable for production signing and keeps local builds working. -->
    <UpdateApiBaseUrl Condition="'$(UpdateApiBaseUrl)' == ''"></UpdateApiBaseUrl>
    <UpdateSigningPublicKeyBase64 Condition="'$(UpdateSigningPublicKeyBase64)' == ''">MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEAeM6Ch8AThCSZ1hyICH5bYOR1+70NaDS+4ZzSYqDIugTHrhLlD8ANTaSaHQKp/flLFpIwmWAek7Bw6BZV7CXwg==</UpdateSigningPublicKeyBase64>
    <UsingDefaultUpdateSigningKey Condition="'$(UsingDefaultUpdateSigningKey)' == ''">true</UsingDefaultUpdateSigningKey>
    <EnableAutomaticUpdatePublishing Condition="'$(EnableAutomaticUpdatePublishing)' == ''">true</EnableAutomaticUpdatePublishing>
  </PropertyGroup>

</Project>
