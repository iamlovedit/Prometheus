<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Local builds use the fallback version. Release workflows inject
         RELEASE_VERSION from the validated v<major>.<minor>.<patch> Git tag. -->
    <EffectiveVersion Condition="'$(RELEASE_VERSION)' == ''">1.0.0</EffectiveVersion>
    <EffectiveVersion Condition="'$(RELEASE_VERSION)' != ''">$(RELEASE_VERSION)</EffectiveVersion>
    <Version>$(EffectiveVersion)</Version>
    <AssemblyVersion>$(EffectiveVersion).0</AssemblyVersion>
    <FileVersion>$(EffectiveVersion).0</FileVersion>
    <InformationalVersion>$(EffectiveVersion)</InformationalVersion>

    <GitHubRepositoryOwner Condition="'$(GitHubRepositoryOwner)' == ''">iamlovedit</GitHubRepositoryOwner>
    <GitHubRepositoryName Condition="'$(GitHubRepositoryName)' == ''">Prometheus</GitHubRepositoryName>
  </PropertyGroup>

</Project>
